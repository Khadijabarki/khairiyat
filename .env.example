# Copy this file to .env.local and fill in your own values.
# Never put NEXT_PUBLIC_ in front of these: they must stay on the server.
# .env.local is git-ignored, so your real keys are never committed.

# Gemini (https://aistudio.google.com) - required
GEMINI_API_KEY=

# Supabase (Project Settings -> API) - used for saving check-ins
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...), used for family sign-in
SUPABASE_PUBLISHABLE_KEY=

# Telegram (@BotFather token, and your chat id from getUpdates) - optional family alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional settings
# Phone number for the "call your son/daughter" emergency button in the demo, e.g. +923001234567
DEMO_CHILD_PHONE=
# Gemini Live model and voices (defaults: gemini-3.8-live, Sulafat, Achird)
GEMINI_LIVE_MODEL=
GEMINI_VOICE_FEMALE=
GEMINI_VOICE_MALE=

# Optional: Gemini model for summaries (default gemini-3.5-flash-lite)
GEMINI_TEXT_MODEL=

# Shared demo account for judges (npm run setup:demo). Use a long random password.
DEMO_EMAIL=demo@khairiyat.app
DEMO_PASSWORD=

# Web Push for ringing the parent's phone. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example
# Long random secret; the scheduler sends it to /api/cron/tick
CRON_SECRET=
